{
  "version": 8,
  "name": "Natural Earth (PLATO tools)",
  "metadata": {
    "plato-tools:note": "Every URL starts {base}/, which the page must replace with the absolute URL of this folder (no trailing slash) before giving the style to MapLibre. See README.md."
  },
  "glyphs": "{base}/glyphs/{fontstack}/{range}.pbf",
  "sources": {
    "land": { "type": "geojson", "data": "{base}/land.geojson", "maxzoom": 10, "tolerance": 0.5,
      "attribution": "Natural Earth (public domain). Borders are Natural Earth's de-facto boundaries, not a statement on any dispute." },
    "countries": { "type": "geojson", "data": "{base}/countries.geojson", "maxzoom": 10, "tolerance": 0.5 },
    "boundaries": { "type": "geojson", "data": "{base}/boundaries.geojson", "maxzoom": 10 },
    "admin1": { "type": "geojson", "data": "{base}/admin1.geojson", "maxzoom": 10 },
    "lakes": { "type": "geojson", "data": "{base}/lakes.geojson", "maxzoom": 10, "tolerance": 0.5 },
    "rivers": { "type": "geojson", "data": "{base}/rivers.geojson", "maxzoom": 10 },
    "country-labels": { "type": "geojson", "data": "{base}/country-labels.geojson", "maxzoom": 8 },
    "places": { "type": "geojson", "data": "{base}/places.geojson", "maxzoom": 10 }
  },
  "layers": [
    { "id": "ocean", "type": "background", "paint": { "background-color": "#d5e3ea" } },
    { "id": "land", "type": "fill", "source": "land",
      "paint": { "fill-color": "#f4f2ec", "fill-antialias": false } },
    { "id": "country-tint", "type": "fill", "source": "countries",
      "paint": {
        "fill-color": ["match", ["get", "tint"],
          1, "#efe9df", 2, "#ecefe4", 3, "#f1ece6", 4, "#e9ede8", 5, "#f0ebe2", 6, "#ebebe6", 7, "#eeeae4", "#f4f2ec"],
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 0, 0.9, 7, 0.5],
        "fill-antialias": false } },
    { "id": "rivers", "type": "line", "source": "rivers",
      "filter": ["<=", ["get", "min_zoom"], ["+", ["zoom"], 1]],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": { "line-color": "#a9c4d4",
        "line-width": ["interpolate", ["linear"], ["zoom"], 1, 0.4, 5, 0.9, 9, 1.6] } },
    { "id": "lakes", "type": "fill", "source": "lakes",
      "paint": { "fill-color": "#d5e3ea", "fill-outline-color": "#bfd3de" } },
    { "id": "admin1", "type": "line", "source": "admin1", "minzoom": 3,
      "layout": { "line-join": "round" },
      "paint": { "line-color": "#c9c1c6", "line-dasharray": [3, 2],
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.4, 8, 0.9] } },
    { "id": "boundaries", "type": "line", "source": "boundaries",
      "filter": ["==", ["get", "kind"], "international"],
      "layout": { "line-join": "round" },
      "paint": { "line-color": "#a99aa6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 1, 0.5, 5, 1, 9, 1.8] } },
    { "id": "boundaries-disputed", "type": "line", "source": "boundaries",
      "filter": ["!=", ["get", "kind"], "international"],
      "layout": { "line-join": "round" },
      "paint": { "line-color": "#a99aa6", "line-dasharray": [2, 2],
        "line-width": ["interpolate", ["linear"], ["zoom"], 1, 0.5, 5, 1, 9, 1.8] } },
    { "id": "river-labels", "type": "symbol", "source": "rivers", "minzoom": 5,
      "filter": ["all", ["!=", ["get", "name"], ""], ["<=", ["get", "min_zoom"], ["zoom"]]],
      "layout": { "symbol-placement": "line", "text-field": ["get", "name"], "text-font": ["Noto Sans Regular"],
        "text-size": 11, "text-letter-spacing": 0.05, "symbol-spacing": 400 },
      "paint": { "text-color": "#6f93a8", "text-halo-color": "#f4f2ec", "text-halo-width": 1.2 } },
    { "id": "lake-labels", "type": "symbol", "source": "lakes", "minzoom": 4,
      "filter": ["all", ["!=", ["get", "name"], ""], ["<=", ["get", "min_zoom"], ["zoom"]]],
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Regular"], "text-size": 11,
        "text-max-width": 7 },
      "paint": { "text-color": "#6f93a8", "text-halo-color": "#d5e3ea", "text-halo-width": 1 } },
    { "id": "country-labels", "type": "symbol", "source": "country-labels",
      "filter": ["all", ["<=", ["get", "min_zoom"], ["+", ["zoom"], 0.5]], [">=", ["get", "max_zoom"], ["zoom"]]],
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 1, 10, 4, 13, 7, 15],
        "text-letter-spacing": 0.12, "text-transform": "uppercase", "text-max-width": 8,
        "symbol-sort-key": ["get", "min_zoom"] },
      "paint": { "text-color": "#948a80", "text-halo-color": "#f4f2ec", "text-halo-width": 1.2 } },
    { "id": "place-dots", "type": "circle", "source": "places",
      "filter": ["<=", ["get", "min_zoom"], ["+", ["zoom"], 1]],
      "paint": { "circle-color": "#6b6660", "circle-stroke-color": "#f4f2ec", "circle-stroke-width": 0.8,
        "circle-radius": ["case", ["==", ["get", "cap"], 1], 3, 2] } },
    { "id": "place-labels", "type": "symbol", "source": "places",
      "filter": ["<=", ["get", "min_zoom"], ["+", ["zoom"], 1]],
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Regular"],
        "text-size": ["case", ["==", ["get", "cap"], 1], 13, ["<=", ["get", "rank"], 4], 12, 11],
        "text-variable-anchor": ["left", "right", "top", "bottom"], "text-radial-offset": 0.5,
        "text-justify": "auto", "text-max-width": 8, "symbol-sort-key": ["get", "rank"] },
      "paint": { "text-color": "#4a4541", "text-halo-color": "#f4f2ec", "text-halo-width": 1.3 } }
  ]
}
