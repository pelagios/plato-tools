    given-names: Stephen
    orcid: "https://orcid.org/0000-0003-3060-0181"
    email: stephen.gadd@pitt.edu
    affiliation: "Institute for Spatial History Innovation (ISHI), University of Pittsburgh"
version: 0.9.0-alpha.2
license: BSD-3-Clause
